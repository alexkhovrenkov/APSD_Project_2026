# Copy this file to pipeline/.env (which is git-ignored) and fill in values locally.
# NEVER commit .env, paste keys into chat, or put keys in code/notebooks.

# --- Onshape (Path B) ----------------------------------------------------------
# Onshape > user icon > My account > Developer > API keys (read permission is enough).
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=
# hmac (default, signed requests) | basic (Onshape: "local testing only") | anonymous
ONSHAPE_AUTH_MODE=hmac
# Optional: defaults to the team's APSD-LATHE Part Studio URL
ONSHAPE_DOCUMENT_URL=

